# OpenRouter API key used to send audience snapshots to Llama 4 Maverick.
# Create one from your OpenRouter dashboard: https://openrouter.ai/
OPENROUTER_API_KEY=""

# ElevenLabs Conversational AI agent ID for the host persona you configured.
# Copy this from your ElevenLabs agent settings page.
ELEVENLABS_AGENT_ID=""


# ElevenLabs API key used to open the Conversational AI WebSocket session.
# Create or copy this from your ElevenLabs account API keys page.
ELEVENLABS_API_KEY=""

# Laptop camera index used by OpenCV. Keep 0 for the default camera unless needed.
CAMERA_INDEX=0

# Number of seconds between audience image captures.
IMAGE_CAPTURE_INTERVAL=60
